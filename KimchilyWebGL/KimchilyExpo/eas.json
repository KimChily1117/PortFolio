{
  "cli": { "version": ">=24.7.0", "appVersionSource": "local" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "KIMCHILY_ALLOW_LAN_HTTP": "1" }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "KIMCHILY_ALLOW_LAN_HTTP": "1",
        "EXPO_PUBLIC_WORLD_SERVER_URL": "http://192.168.0.4:8788"
      }
    },
    "production": {
      "env": { "KIMCHILY_ALLOW_LAN_HTTP": "0" }
    }
  }
}
