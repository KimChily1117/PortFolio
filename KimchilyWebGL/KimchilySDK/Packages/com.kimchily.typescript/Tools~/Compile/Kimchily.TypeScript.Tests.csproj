<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../../../tools/Unity.Build.props" />
  <PropertyGroup><UnityTestProject>$(KimchilyWorkspaceRoot)/KimchilyUnityRuntime</UnityTestProject></PropertyGroup>
  <Import Project="../../../../../tools/Unity.TestReferences.props" />
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AssemblyName>Kimchily.TypeScript.Runtime.Tests</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Tests/Runtime/**/*.cs" />
    <Reference Include="$(UnityEditorRoot)/Data/Managed/UnityEngine/*.dll" />
